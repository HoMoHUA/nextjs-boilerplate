# ---- Copy to deploy/.env.production and fill in. Never commit the real file. ----

# Public hostname (DNS A record → this server). Used by Caddy and docker compose.
DOMAIN=office.example.com
ACME_EMAIL=you@example.com
APP_PORT=3000

# Login: everyone who opens the site must enter this password. Required in production.
OFFICE_PASSWORD=change-me-to-a-long-random-password
# Random secret for signing session cookies (openssl rand -hex 32). Changing it signs everyone out.
OFFICE_SESSION_SECRET=

# hermes-agent OpenAI-compatible API server on the same host
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# Claude Code backend (off unless "true"). Needs WITH_CLAUDE_CODE=true at build time,
# a Claude Code login for the app user and the project mounted at CLAUDE_CODE_CWD.
CLAUDE_CODE_ENABLED=false
WITH_CLAUDE_CODE=false
# CLAUDE_CODE_CWD=/srv/your-repo
# CLAUDE_CODE_MODEL=opus
# CLAUDE_CODE_PERMISSION_MODE=acceptEdits
