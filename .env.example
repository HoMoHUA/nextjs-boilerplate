# --- hermes-agent ---------------------------------------------------------
# OpenAI-compatible API server (API_SERVER_ENABLED=true in ~/.hermes/.env, then `hermes gateway`)
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me
HERMES_MODEL=hermes-agent

# --- Claude Code (Agent SDK) with subagents ------------------------------
# Uses your Claude Code login (`claude`) or ANTHROPIC_API_KEY on this machine.
# Project whose .claude/agents/*.md subagents and CLAUDE.md are loaded:
CLAUDE_CODE_CWD=/path/to/your/repo
# Optional:
# CLAUDE_CODE_MODEL=opus
# CLAUDE_CODE_PERMISSION_MODE=acceptEdits   # default | acceptEdits | plan | dontAsk | auto | bypassPermissions
# CLAUDE_CODE_MAX_TURNS=40
# CLAUDE_CODE_ENABLED=false
